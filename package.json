{
  "name": "@takosjp/takosumi-store",
  "version": "0.1.14",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Takosumi Store — a self-hostable store for Takos Capsules with an open HTTP/JSON read API (TCS). Browse and install Capsules; publishers register listings.",
  "scripts": {
    "dev": "bunx wrangler dev --config wrangler.local.toml",
    "dev:web": "bunx vite --config web/vite.config.ts",
    "check": "bun run fmt:check && bun run lint && bun run test && bun run build",
    "deploy": "bun scripts/deploy.mjs",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test test/ src/backend/ spec/",
    "build": "bunx vite build --config web/vite.config.ts",
    "deploy:self-host": "bun scripts/self-host-deploy.ts",
    "lint": "bun run typecheck",
    "fmt": "bunx prettier --write spec src web test scripts",
    "fmt:check": "bunx prettier --check spec src web test scripts",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@solidjs/router": "^0.15.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "latest",
    "@types/node": "^22.20.1",
    "babel-preset-solid": "^1.9.12",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "solid-refresh": "^0.6.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14",
    "vitefu": "^1.1.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "postcss": "8.5.23"
  }
}
